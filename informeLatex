\begin{align*}
\Delta U&=m\int_0^H g(y)\,dy=m g_0R^2\left[-\frac1{R+y}\right]_0^H\\
&=\frac{m g_0 R H}{R+H}=\boxed{3.486236787\times10^9\ \mathrm{J}}.
\end{align*}
